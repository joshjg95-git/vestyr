# Local development only. Copy to .dev.vars for `wrangler dev`.
# Names only — never commit real values.

# Turnstile SECRET key (server-side). Cloudflare > Turnstile > your widget.
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000

# Verified destination for contact enquiries.
CONTACT_RECIPIENT=you@example.com

# Sender on the Cloudflare-onboarded domain.
CONTACT_SENDER=website@vestyr.com

# Build-time only. Turnstile SITE key is public and is inlined into the HTML.
TURNSTILE_SITE_KEY=0x4AAAAAAA_site_key_here
